# name: test/sql/grainlift_execute.test
# description: test grainlift_execute function for DDL/DML statements
# group: [adbc]

require grainlift

require httpfs

require-env GRAINLIFT_URI

require-env GRAINLIFT_TOKEN

# ============================================
# NULL Connection Handle Tests
# ============================================

# Test grainlift_execute with NULL connection handle
statement error
CALL grainlift_execute(NULL, 'SELECT 1');
----
Invalid Input Error: grainlift_execute: Connection handle cannot be NULL

# Test grainlift_execute with NULL query
statement error
CALL grainlift_execute(12345, NULL);
----
Invalid Input Error: grainlift_execute: Query cannot be NULL

# ============================================
# Normal Tests
# ============================================

statement ok
SET VARIABLE conn_id = (SELECT grainlift_connect({'uri': '${GRAINLIFT_URI}', 'target': 'sqlite', 'bearer_token': '${GRAINLIFT_TOKEN}', 'remote_uri': ':memory:'}));

# Test CREATE TABLE
statement ok
CALL grainlift_execute(getvariable('conn_id')::BIGINT, 'CREATE TABLE exec_test (id INTEGER PRIMARY KEY, name TEXT)');

# Test INSERT
statement ok
CALL grainlift_execute(getvariable('conn_id')::BIGINT, 'INSERT INTO exec_test VALUES (1, ''hello''), (2, ''world'')');

# Verify data was inserted
query II
SELECT * FROM grainlift_scan(getvariable('conn_id')::BIGINT, 'SELECT * FROM exec_test ORDER BY id', columns := {'id': 'BIGINT', 'name': 'VARCHAR'});
----
1	hello
2	world

# Test UPDATE
statement ok
CALL grainlift_execute(getvariable('conn_id')::BIGINT, 'UPDATE exec_test SET name = ''updated'' WHERE id = 1');

# Verify update worked
query II
SELECT * FROM grainlift_scan(getvariable('conn_id')::BIGINT, 'SELECT * FROM exec_test WHERE id = 1', columns := {'id': 'BIGINT', 'name': 'VARCHAR'});
----
1	updated

# Test DELETE
statement ok
CALL grainlift_execute(getvariable('conn_id')::BIGINT, 'DELETE FROM exec_test WHERE id = 2');

# Verify delete worked
query I
SELECT COUNT(*) FROM grainlift_scan(getvariable('conn_id')::BIGINT, 'SELECT * FROM exec_test', columns := {'id': 'BIGINT', 'name': 'VARCHAR'});
----
1

# Test grainlift_execute with invalid connection handle
statement error
CALL grainlift_execute(12345, 'SELECT 1');
----
Invalid Input Error: grainlift_execute: Invalid connection handle: 12345

# Clean up
statement ok
CALL grainlift_disconnect(getvariable('conn_id')::BIGINT);
