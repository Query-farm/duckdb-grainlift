# name: test/sql/grainlift_execute.test
# description: test grainlift_execute function for DDL/DML statements
# group: [adbc]

require grainlift

require httpfs

require-env GRAINLIFT_URI

require-env GRAINLIFT_TOKEN

# ============================================
# NULL Connection Handle Tests
# ============================================

# Test grainlift_execute with a NULL database name
statement error
CALL grainlift_execute(NULL, 'SELECT 1');
----
grainlift_execute: database name cannot be NULL

# Test grainlift_execute with NULL query
statement error
CALL grainlift_execute('nope', NULL);
----
Invalid Input Error: grainlift_execute: Query cannot be NULL

# ============================================
# Normal Tests
# ============================================

statement ok
ATTACH '${GRAINLIFT_URI}' AS conn_id (TYPE grainlift, target 'sqlite', bearer_token '${GRAINLIFT_TOKEN}', remote_uri ':memory:');

# Test CREATE TABLE
statement ok
CALL grainlift_execute('conn_id', 'CREATE TABLE exec_test (id INTEGER PRIMARY KEY, name TEXT)');

# Test INSERT
statement ok
CALL grainlift_execute('conn_id', 'INSERT INTO exec_test VALUES (1, ''hello''), (2, ''world'')');

# Verify data was inserted
query II
SELECT * FROM grainlift_scan('conn_id', 'SELECT * FROM exec_test ORDER BY id', columns := {'id': 'BIGINT', 'name': 'VARCHAR'});
----
1	hello
2	world

# Test UPDATE
statement ok
CALL grainlift_execute('conn_id', 'UPDATE exec_test SET name = ''updated'' WHERE id = 1');

# Verify update worked
query II
SELECT * FROM grainlift_scan('conn_id', 'SELECT * FROM exec_test WHERE id = 1', columns := {'id': 'BIGINT', 'name': 'VARCHAR'});
----
1	updated

# Test DELETE
statement ok
CALL grainlift_execute('conn_id', 'DELETE FROM exec_test WHERE id = 2');

# Verify delete worked
query I
SELECT COUNT(*) FROM grainlift_scan('conn_id', 'SELECT * FROM exec_test', columns := {'id': 'BIGINT', 'name': 'VARCHAR'});
----
1

# Test grainlift_execute with an unknown database name
statement error
CALL grainlift_execute('nope', 'SELECT 1');
----
Binder Error: grainlift_execute: no attached database named "nope"

# Clean up
statement ok
DETACH conn_id;
