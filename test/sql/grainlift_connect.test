# name: test/sql/grainlift_connect.test
# description: test grainlift connection functions
# group: [grainlift]

# Before we load the extension, this will fail
statement error
SELECT grainlift_connect({'uri': 'grainlift+http://127.0.0.1:1', 'target': 't'});
----
Catalog Error: Scalar Function with name grainlift_connect does not exist!

# Require statement will ensure this test is run with this extension loaded
require grainlift

require httpfs

statement error
SELECT grainlift_connect({'target': 'sqlite'});
----
Invalid Input Error: grainlift: a 'uri' option naming the grainlift service is required

statement error
SELECT grainlift_connect(MAP {'uri': 'grainlift+http://127.0.0.1:1'});
----
Invalid Input Error: grainlift: a 'target' option naming the server-side target is required

# Dynamic driver loading does not exist in this extension
statement error
SELECT grainlift_connect({'uri': 'grainlift+http://127.0.0.1:1', 'target': 't', 'driver': 'sqlite'});
----
option 'driver' is not supported; the grainlift driver is built in

statement error
SELECT grainlift_connect({'uri': 'grainlift+http://127.0.0.1:1', 'target': 't', 'grainlift.internal.host_ctx': '1'});
----
is reserved

# Test disconnect with invalid handle
statement error
CALL grainlift_disconnect(12345);
----
Invalid Input Error: grainlift_disconnect: Invalid connection handle: 12345

require-env GRAINLIFT_URI

require-env GRAINLIFT_TOKEN

# An unreachable service surfaces as an IO error from the host HTTP layer
statement error
SELECT grainlift_connect({'uri': 'grainlift+http://127.0.0.1:9', 'target': 'sqlite', 'bearer_token': 'x'});
----
grainlift: HTTP

# Wrong credentials
statement error
SELECT grainlift_connect({'uri': '${GRAINLIFT_URI}', 'target': 'sqlite', 'bearer_token': 'wrong-token'});
----

# Test basic connection with STRUCT syntax
statement ok
SET VARIABLE conn_id = (SELECT grainlift_connect({'uri': '${GRAINLIFT_URI}', 'target': 'sqlite', 'bearer_token': '${GRAINLIFT_TOKEN}', 'remote_uri': ':memory:'}));

# Test basic connection with MAP syntax
statement ok
SET VARIABLE map_conn = (SELECT grainlift_connect(MAP {'uri': '${GRAINLIFT_URI}', 'target': 'sqlite', 'bearer_token': '${GRAINLIFT_TOKEN}', 'remote_uri': ':memory:'}));

# The remote driver is reported through grainlift_info
query I
SELECT count(*) > 0 FROM grainlift_info(getvariable('conn_id')::BIGINT) WHERE info_value ILIKE '%sqlite%';
----
true

# Test disconnect
query I
CALL grainlift_disconnect(getvariable('conn_id')::BIGINT);
----
true

query I
CALL grainlift_disconnect(getvariable('map_conn')::BIGINT);
----
true

# Test that connection is invalid after disconnect
statement error
SELECT * FROM grainlift_scan(getvariable('conn_id')::BIGINT, 'SELECT 1');
----
Invalid Input Error: grainlift_scan: Invalid connection handle
