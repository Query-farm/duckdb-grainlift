# name: test/sql/grainlift_connect.test
# description: connecting with ATTACH and naming the attached database in grainlift_* functions
# group: [grainlift]

# Before we load the extension, this will fail
statement error
SELECT * FROM grainlift_info('db');
----
Catalog Error: Table Function with name grainlift_info does not exist!

# Require statement will ensure this test is run with this extension loaded
require grainlift

require httpfs

statement error
ATTACH '' AS db (TYPE grainlift, target 'sqlite');
----
Invalid Input Error: grainlift: a 'uri' option naming the grainlift service is required

statement error
ATTACH 'grainlift+http://127.0.0.1:1' AS db (TYPE grainlift);
----
Invalid Input Error: grainlift: a 'target' option naming the server-side target is required

# Dynamic driver loading does not exist in this extension
statement error
ATTACH 'grainlift+http://127.0.0.1:1' AS db (TYPE grainlift, target 't', driver 'sqlite');
----
option 'driver' is not supported; the grainlift driver is built in

# The functions name an attached grainlift database
statement error
SELECT * FROM grainlift_info('nope');
----
Binder Error: grainlift_info: no attached database named "nope"

statement ok
ATTACH ':memory:' AS plain_duckdb;

statement error
SELECT * FROM grainlift_scan('plain_duckdb', 'SELECT 1');
----
Binder Error: grainlift_scan: "plain_duckdb" is a duckdb database, not a grainlift one

statement error
SELECT * FROM grainlift_scan(NULL, 'SELECT 1');
----
database name cannot be NULL

require-env GRAINLIFT_URI

require-env GRAINLIFT_TOKEN

# An unreachable service surfaces as an IO error from the host HTTP layer
statement error
ATTACH 'grainlift+http://127.0.0.1:9' AS db (TYPE grainlift, target 'sqlite', bearer_token 'x');
----
grainlift: HTTP

# Wrong credentials
statement error
ATTACH '${GRAINLIFT_URI}' AS db (TYPE grainlift, target 'sqlite', bearer_token 'wrong-token');
----

# OAuth needs a gateway that advertises it (the test gateway uses static tokens)
statement error
ATTACH '${GRAINLIFT_URI}' AS db (TYPE grainlift, target 'sqlite', oauth_refresh_token 'r');
----
does not advertise OAuth

statement ok
ATTACH '${GRAINLIFT_URI}' AS db (TYPE grainlift, target 'sqlite', bearer_token '${GRAINLIFT_TOKEN}', remote_uri ':memory:');

# The remote driver is reported through grainlift_info
query I
SELECT count(*) > 0 FROM grainlift_info('db') WHERE info_value ILIKE '%sqlite%';
----
true

# The alias is what names it, case-insensitively like any catalog
query I
SELECT * FROM grainlift_scan('DB', 'SELECT 42 AS answer', columns := {'answer': 'BIGINT'});
----
42

statement ok
ATTACH '${GRAINLIFT_URI}' AS other_alias (TYPE grainlift, target 'sqlite', bearer_token '${GRAINLIFT_TOKEN}', remote_uri ':memory:');

query I
SELECT * FROM grainlift_scan('other_alias', 'SELECT 7 AS n', columns := {'n': 'BIGINT'});
----
7

statement ok
DETACH db;

statement ok
DETACH other_alias;

# After DETACH the name no longer resolves
statement error
SELECT * FROM grainlift_scan('db', 'SELECT 1');
----
Binder Error: grainlift_scan: no attached database named "db"
