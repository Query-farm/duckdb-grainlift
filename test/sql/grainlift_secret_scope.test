# name: test/sql/grainlift_secret_scope.test
# description: URI-derived grainlift secret scope without connecting
# group: [grainlift]

require grainlift

require httpfs

statement ok
CREATE SECRET inferred_scope (TYPE grainlift, URI 'grainlift+iroh://endpoint-a', TARGET 'pg');

query I
SELECT scope = ['grainlift+iroh://endpoint-a'] FROM duckdb_secrets() WHERE name = 'inferred_scope';
----
true

statement ok
CREATE SECRET explicit_scope (TYPE grainlift, URI 'grainlift+https://host/db', SCOPE 'grainlift+https://host');

query I
SELECT scope = ['grainlift+https://host'] FROM duckdb_secrets() WHERE name = 'explicit_scope';
----
true

statement ok
CREATE SECRET scope_only (TYPE grainlift, TARGET 'x', SCOPE 'custom://host');

query I
SELECT scope = ['custom://host'] FROM duckdb_secrets() WHERE name = 'scope_only';
----
true

# bearer_token is redacted
statement ok
CREATE SECRET redacted (TYPE grainlift, URI 'grainlift+https://r', BEARER_TOKEN 's3cr3t');

query I
SELECT secret_string NOT LIKE '%s3cr3t%' FROM duckdb_secrets() WHERE name = 'redacted';
----
true

# so are OAuth refresh tokens and client secrets
statement ok
CREATE SECRET oauth_redacted (TYPE grainlift, URI 'grainlift+https://o', OAUTH_REFRESH_TOKEN 'r3fr3sh', OAUTH_CLIENT_SECRET 'cl13nt');

query I
SELECT secret_string NOT LIKE '%r3fr3sh%' AND secret_string NOT LIKE '%cl13nt%' FROM duckdb_secrets() WHERE name = 'oauth_redacted';
----
true

statement ok
DROP SECRET oauth_redacted;

statement error
CREATE SECRET missing_scope (TYPE grainlift, TARGET 'x');
----
grainlift secret requires a non-empty URI or an explicit SCOPE

statement error
CREATE SECRET empty_uri (TYPE grainlift, URI '');
----
grainlift secret requires a non-empty URI or an explicit SCOPE

statement error
CREATE SECRET null_uri (TYPE grainlift, URI NULL);
----
grainlift secret requires a non-empty URI or an explicit SCOPE

statement ok
DROP SECRET inferred_scope;

statement ok
DROP SECRET explicit_scope;

statement ok
DROP SECRET scope_only;

statement ok
DROP SECRET redacted;
