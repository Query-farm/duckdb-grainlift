# name: test/sql/grainlift_secrets.test
# description: test grainlift secrets integration
# group: [grainlift]

require grainlift

require httpfs

require-env GRAINLIFT_URI

require-env GRAINLIFT_TOKEN

# A secret scoped to the grainlift service URI supplies target + credentials
statement ok
CREATE SECRET svc (
    TYPE grainlift,
    URI '${GRAINLIFT_URI}',
    TARGET 'sqlite',
    BEARER_TOKEN '${GRAINLIFT_TOKEN}'
);

statement ok
ATTACH '${GRAINLIFT_URI}' AS scoped_conn (TYPE grainlift, remote_uri ':memory:');

query II
SELECT * FROM grainlift_scan('scoped_conn', 'SELECT 1 AS a, 2 AS b', columns := {'a': 'BIGINT', 'b': 'BIGINT'});
----
1	2

statement ok
DETACH scoped_conn;

# Explicit secret name
statement ok
CREATE SECRET named_secret (
    TYPE grainlift,
    SCOPE 'grainlift://named',
    URI '${GRAINLIFT_URI}',
    TARGET 'sqlite',
    BEARER_TOKEN '${GRAINLIFT_TOKEN}',
    REMOTE_URI ':memory:'
);

statement ok
ATTACH '' AS named_conn (TYPE grainlift, secret 'named_secret');

query II
SELECT * FROM grainlift_scan('named_conn', 'SELECT 3 AS x, 4 AS y', columns := {'x': 'BIGINT', 'y': 'BIGINT'});
----
3	4

statement ok
DETACH named_conn;

# Explicit options override secret values (a bad remote_uri in the secret)
statement ok
CREATE SECRET override_secret (
    TYPE grainlift,
    SCOPE 'grainlift://override',
    URI '${GRAINLIFT_URI}',
    TARGET 'sqlite',
    BEARER_TOKEN '${GRAINLIFT_TOKEN}',
    REMOTE_URI '/nonexistent/path.db'
);

statement ok
ATTACH '' AS override_conn (TYPE grainlift, secret 'override_secret', remote_uri ':memory:');

query I
SELECT * FROM grainlift_scan('override_conn', 'SELECT 42 AS val', columns := {'val': 'BIGINT'});
----
42

statement ok
DETACH override_conn;

statement error
ATTACH '' AS missing_secret (TYPE grainlift, secret 'nonexistent_secret');
----
Binder Error: Secret with name "nonexistent_secret" not found

# ATTACH resolves the secret by the attached URI
statement ok
ATTACH '${GRAINLIFT_URI}' AS via_secret (TYPE grainlift, remote_uri ':memory:');

statement ok
DETACH via_secret;

statement ok
DROP SECRET svc;

statement ok
DROP SECRET named_secret;

statement ok
DROP SECRET override_secret;
