# name: test/sql/grainlift_secrets.test
# description: test grainlift secrets integration
# group: [grainlift]

require grainlift

require httpfs

require-env GRAINLIFT_URI

require-env GRAINLIFT_TOKEN

# A secret scoped to the grainlift service URI supplies target + credentials
statement ok
CREATE SECRET svc (
    TYPE grainlift,
    URI '${GRAINLIFT_URI}',
    TARGET 'sqlite',
    BEARER_TOKEN '${GRAINLIFT_TOKEN}'
);

statement ok
SET VARIABLE scoped_conn = (SELECT grainlift_connect({'uri': '${GRAINLIFT_URI}', 'remote_uri': ':memory:'}));

query II
SELECT * FROM grainlift_scan(getvariable('scoped_conn')::BIGINT, 'SELECT 1 AS a, 2 AS b', columns := {'a': 'BIGINT', 'b': 'BIGINT'});
----
1	2

statement ok
CALL grainlift_disconnect(getvariable('scoped_conn')::BIGINT);

# Explicit secret name
statement ok
CREATE SECRET named_secret (
    TYPE grainlift,
    SCOPE 'grainlift://named',
    URI '${GRAINLIFT_URI}',
    TARGET 'sqlite',
    BEARER_TOKEN '${GRAINLIFT_TOKEN}',
    REMOTE_URI ':memory:'
);

statement ok
SET VARIABLE named_conn = (SELECT grainlift_connect({'secret': 'named_secret'}));

query II
SELECT * FROM grainlift_scan(getvariable('named_conn')::BIGINT, 'SELECT 3 AS x, 4 AS y', columns := {'x': 'BIGINT', 'y': 'BIGINT'});
----
3	4

statement ok
CALL grainlift_disconnect(getvariable('named_conn')::BIGINT);

# Explicit options override secret values (a bad remote_uri in the secret)
statement ok
CREATE SECRET override_secret (
    TYPE grainlift,
    SCOPE 'grainlift://override',
    URI '${GRAINLIFT_URI}',
    TARGET 'sqlite',
    BEARER_TOKEN '${GRAINLIFT_TOKEN}',
    REMOTE_URI '/nonexistent/path.db'
);

statement ok
SET VARIABLE override_conn = (SELECT grainlift_connect({'secret': 'override_secret', 'remote_uri': ':memory:'}));

query I
SELECT * FROM grainlift_scan(getvariable('override_conn')::BIGINT, 'SELECT 42 AS val', columns := {'val': 'BIGINT'});
----
42

statement ok
CALL grainlift_disconnect(getvariable('override_conn')::BIGINT);

statement error
SELECT grainlift_connect({'secret': 'nonexistent_secret'});
----
Binder Error: Secret with name "nonexistent_secret" not found

# ATTACH resolves the secret by the attached URI
statement ok
ATTACH '${GRAINLIFT_URI}' AS via_secret (TYPE grainlift, remote_uri ':memory:');

statement ok
DETACH via_secret;

statement ok
DROP SECRET svc;

statement ok
DROP SECRET named_secret;

statement ok
DROP SECRET override_secret;
