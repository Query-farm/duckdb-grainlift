# name: test/sql/grainlift_secrets.test
# description: test grainlift secrets integration
# group: [grainlift]

require grainlift

require httpfs

require-env GRAINLIFT_URI

require-env GRAINLIFT_TOKEN

# A secret scoped to the grainlift service URI supplies target + credentials
statement ok
CREATE SECRET svc (
    TYPE grainlift,
    URI '${GRAINLIFT_URI}',
    TARGET 'sqlite',
    BEARER_TOKEN '${GRAINLIFT_TOKEN}'
);

statement ok
ATTACH '${GRAINLIFT_URI}' AS scoped_conn (TYPE grainlift, remote_uri ':memory:');

query II
SELECT * FROM grainlift_scan('scoped_conn', 'SELECT 1 AS a, 2 AS b', columns := {'a': 'BIGINT', 'b': 'BIGINT'});
----
1	2

statement ok
DETACH scoped_conn;

# Explicit secret name
statement ok
CREATE SECRET named_secret (
    TYPE grainlift,
    SCOPE 'grainlift://named',
    URI '${GRAINLIFT_URI}',
    TARGET 'sqlite',
    BEARER_TOKEN '${GRAINLIFT_TOKEN}',
    REMOTE_URI ':memory:'
);

statement ok
ATTACH '' AS named_conn (TYPE grainlift, secret 'named_secret');

query II
SELECT * FROM grainlift_scan('named_conn', 'SELECT 3 AS x, 4 AS y', columns := {'x': 'BIGINT', 'y': 'BIGINT'});
----
3	4

statement ok
DETACH named_conn;

# Explicit options override secret values (a bad remote_uri in the secret)
statement ok
CREATE SECRET override_secret (
    TYPE grainlift,
    SCOPE 'grainlift://override',
    URI '${GRAINLIFT_URI}',
    TARGET 'sqlite',
    BEARER_TOKEN '${GRAINLIFT_TOKEN}',
    REMOTE_URI '/nonexistent/path.db'
);

statement ok
ATTACH '' AS override_conn (TYPE grainlift, secret 'override_secret', remote_uri ':memory:');

query I
SELECT * FROM grainlift_scan('override_conn', 'SELECT 42 AS val', columns := {'val': 'BIGINT'});
----
42

statement ok
DETACH override_conn;

statement error
ATTACH '' AS missing_secret (TYPE grainlift, secret 'nonexistent_secret');
----
Binder Error: Secret with name "nonexistent_secret" not found

# ATTACH resolves the secret by the attached URI
statement ok
ATTACH '${GRAINLIFT_URI}' AS via_secret (TYPE grainlift, remote_uri ':memory:');

statement ok
DETACH via_secret;

# attach_secret is an alias of secret
statement ok
ATTACH '' AS attach_secret_conn (TYPE grainlift, attach_secret 'named_secret');

query I
SELECT * FROM grainlift_scan('attach_secret_conn', 'SELECT 5 AS v', columns := {'v': 'BIGINT'});
----
5

statement ok
DETACH attach_secret_conn;

# Explicit options override the secret's values with attach_secret too
statement ok
ATTACH '' AS attach_override_conn (TYPE grainlift, attach_secret 'override_secret', remote_uri ':memory:');

query I
SELECT * FROM grainlift_scan('attach_override_conn', 'SELECT 6 AS v', columns := {'v': 'BIGINT'});
----
6

statement ok
DETACH attach_override_conn;

# An explicit bad bearer token beats the secret's good one
statement error
ATTACH '${GRAINLIFT_URI}' AS bad_token_conn (TYPE grainlift, remote_uri ':memory:', bearer_token 'wrong-token');
----
invalid_credential

# attach_secret '' disables the scope lookup: no target, no token
statement error
ATTACH '${GRAINLIFT_URI}' AS no_lookup (TYPE grainlift, attach_secret '', remote_uri ':memory:');
----
a 'target' option naming the server-side target is required

# With lookup off, explicit options alone still work
statement ok
ATTACH '${GRAINLIFT_URI}' AS no_lookup (TYPE grainlift, attach_secret '', target 'sqlite', bearer_token '${GRAINLIFT_TOKEN}', remote_uri ':memory:');

statement ok
DETACH no_lookup;

# Secret-sourced values never appear in duckdb_databases()
statement ok
ATTACH '${GRAINLIFT_URI}' AS leak_secret (TYPE grainlift, remote_uri ':memory:');

query I
SELECT count(*) FROM duckdb_databases()
WHERE database_name = 'leak_secret'
  AND options::VARCHAR NOT LIKE '%${GRAINLIFT_TOKEN}%'
  AND options::VARCHAR NOT LIKE '%sqlite%'
  AND path NOT LIKE '%${GRAINLIFT_TOKEN}%';
----
1

statement ok
DETACH leak_secret;

# Explicit credential options are redacted in duckdb_databases()
statement ok
ATTACH '${GRAINLIFT_URI}' AS leak_explicit (TYPE grainlift, attach_secret '', target 'sqlite', bearer_token '${GRAINLIFT_TOKEN}', remote_uri ':memory:');

query II
SELECT options['bearer_token'], options['target'] FROM duckdb_databases() WHERE database_name = 'leak_explicit';
----
<redacted>	sqlite

query I
SELECT count(*) FROM duckdb_databases()
WHERE database_name = 'leak_explicit' AND options::VARCHAR NOT LIKE '%${GRAINLIFT_TOKEN}%';
----
1

statement ok
DETACH leak_explicit;

# ...and so are credentials written into a key=value path
statement ok
ATTACH 'uri=${GRAINLIFT_URI};target=sqlite;token=${GRAINLIFT_TOKEN};remote_uri=:memory:' AS leak_path (TYPE grainlift, attach_secret '');

query I
SELECT path FROM duckdb_databases() WHERE database_name = 'leak_path';
----
uri=${GRAINLIFT_URI};target=sqlite;token=<redacted>;remote_uri=:memory:

statement ok
DETACH leak_path;

statement ok
DROP SECRET svc;

statement ok
DROP SECRET named_secret;

statement ok
DROP SECRET override_secret;
