# name: test/sql/grainlift_catalog.test
# description: test adbc catalog functions (grainlift_info, grainlift_tables, grainlift_columns, grainlift_schema, grainlift_table_types)
# group: [adbc]

require grainlift

require httpfs

require-env GRAINLIFT_URI

require-env GRAINLIFT_TOKEN

# ============================================
# NULL Connection Handle Tests
# ============================================

# Test grainlift_info with a NULL database name
statement error
SELECT * FROM grainlift_info(NULL);
----
grainlift_info: database name cannot be NULL

# Test grainlift_tables with a NULL database name
statement error
SELECT * FROM grainlift_tables(NULL);
----
grainlift_tables: database name cannot be NULL

# Test grainlift_table_types with a NULL database name
statement error
SELECT * FROM grainlift_table_types(NULL);
----
grainlift_table_types: database name cannot be NULL

# Test grainlift_columns with a NULL database name
statement error
SELECT * FROM grainlift_columns(NULL);
----
grainlift_columns: database name cannot be NULL

# Test grainlift_schema with a NULL database name
statement error
SELECT * FROM grainlift_schema(NULL, 'test');
----
grainlift_schema: database name cannot be NULL

# Test grainlift_schema with NULL table name
statement error
SELECT * FROM grainlift_schema('nope', NULL);
----
Invalid Input Error: grainlift_schema: Table name cannot be NULL

# ============================================
# Normal Tests
# ============================================

statement ok
ATTACH '${GRAINLIFT_URI}' AS conn_id (TYPE grainlift, target 'sqlite', bearer_token '${GRAINLIFT_TOKEN}', remote_uri ':memory:');

# ============================================
# grainlift_info Tests
# ============================================

# Test grainlift_info - returns driver/database info
query II
SELECT * FROM grainlift_info('conn_id') WHERE info_name = 'vendor_name';
----
vendor_name	SQLite

# Test grainlift_info - all required info fields should be present
query I
SELECT COUNT(*) >= 3 FROM grainlift_info('conn_id');
----
true

# Test grainlift_info with an unknown database name
statement error
SELECT * FROM grainlift_info('nope');
----
Binder Error: grainlift_info: no attached database named "nope"

# ============================================
# grainlift_tables Tests
# ============================================

# Test grainlift_tables with empty database (no tables created yet)
statement ok
ATTACH '${GRAINLIFT_URI}' AS fresh_conn (TYPE grainlift, target 'sqlite', bearer_token '${GRAINLIFT_TOKEN}', remote_uri ':memory:');

query I
SELECT COUNT(*) FROM grainlift_tables('fresh_conn');
----
0

statement ok
DETACH fresh_conn;

# Test grainlift_tables with an unknown database name
statement error
SELECT * FROM grainlift_tables('nope');
----
Binder Error: grainlift_tables: no attached database named "nope"

# ============================================
# grainlift_table_types Tests
# ============================================

# Test grainlift_table_types - returns supported table types
query I
SELECT * FROM grainlift_table_types('conn_id') ORDER BY table_type;
----
table
view

# Test grainlift_table_types with an unknown database name
statement error
SELECT * FROM grainlift_table_types('nope');
----
Binder Error: grainlift_table_types: no attached database named "nope"

# ============================================
# grainlift_columns Tests
# ============================================

# Create a table for column tests
statement ok
CALL grainlift_execute('conn_id', 'CREATE TABLE test_cols (id INTEGER PRIMARY KEY, name TEXT NOT NULL, value REAL)');

# Test grainlift_columns - basic query
query IIII
SELECT table_name, column_name, ordinal_position, type_name FROM grainlift_columns('conn_id', table_name := 'test_cols') ORDER BY ordinal_position;
----
test_cols	id	1	INTEGER
test_cols	name	2	TEXT
test_cols	value	3	REAL

# Test grainlift_columns - filter by column_name
query II
SELECT table_name, column_name FROM grainlift_columns('conn_id', table_name := 'test_cols', column_name := 'name');
----
test_cols	name

# Test grainlift_columns with an unknown database name
statement error
SELECT * FROM grainlift_columns('nope');
----
Binder Error: grainlift_columns: no attached database named "nope"

# ============================================
# grainlift_schema Tests
# ============================================

# Create a table for schema tests
statement ok
CALL grainlift_execute('conn_id', 'CREATE TABLE schema_test (id INTEGER, name TEXT, value REAL)');

# Test grainlift_schema - get Arrow schema for a table
query I
SELECT field_name FROM grainlift_schema('conn_id', 'schema_test') ORDER BY field_name;
----
id
name
value

# Test grainlift_schema with an unknown database name
statement error
SELECT * FROM grainlift_schema('nope', 'test');
----
Binder Error: grainlift_schema: no attached database named "nope"

# Clean up
statement ok
DETACH conn_id;
