# name: test/sql/grainlift_storage_readonly.test
# description: writes to a READ_ONLY attached ADBC database are rejected
# group: [adbc]

require grainlift

require httpfs

require-env GRAINLIFT_URI

require-env GRAINLIFT_TOKEN

statement ok
ATTACH '${GRAINLIFT_URI}' AS c (TYPE grainlift, target 'sqlite', bearer_token '${GRAINLIFT_TOKEN}', remote_uri '/tmp/test_ro.db');

statement ok
CALL grainlift_execute('c', 'DROP TABLE IF EXISTS t');

statement ok
CALL grainlift_execute('c', 'CREATE TABLE t (id INTEGER)');

statement ok
CALL grainlift_execute('c', 'INSERT INTO t VALUES (1), (2)');

statement ok
DETACH c;

statement ok
ATTACH '${GRAINLIFT_URI}' AS ro (TYPE grainlift, target 'sqlite', bearer_token '${GRAINLIFT_TOKEN}', remote_uri '/tmp/test_ro.db', READ_ONLY);

query I
SELECT COUNT(*) FROM ro.t;
----
2

statement error
INSERT INTO ro.t VALUES (3);
----

statement ok
DETACH ro;
