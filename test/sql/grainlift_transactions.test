# name: test/sql/grainlift_transactions.test
# description: grainlift_execute / grainlift_scan follow DuckDB transactions on the attached database
# group: [grainlift]

require grainlift

require httpfs

require-env GRAINLIFT_URI

require-env GRAINLIFT_TOKEN

# A file database, so the attachment's connections share one SQLite database.
# Integer columns only: SQLite reports an empty table's columns as BIGINT.
statement ok
ATTACH '${GRAINLIFT_URI}' AS db (TYPE grainlift, target 'sqlite', bearer_token '${GRAINLIFT_TOKEN}', remote_uri '/tmp/test_grainlift_txn.db');

statement ok
CALL grainlift_execute('db', 'DROP TABLE IF EXISTS tx_test');

# Outside a transaction grainlift_execute autocommits
statement ok
CALL grainlift_execute('db', 'CREATE TABLE tx_test (id INTEGER, qty INTEGER)');

# ROLLBACK undoes grainlift_execute writes made inside the transaction
statement ok
BEGIN;

statement ok
CALL grainlift_execute('db', 'INSERT INTO tx_test VALUES (1, 10)');

# Reads inside the transaction see its own uncommitted writes
query I
SELECT count(*) FROM grainlift_scan('db', 'SELECT * FROM tx_test', columns := {'id': 'BIGINT', 'qty': 'BIGINT'});
----
1

statement ok
ROLLBACK;

query I
SELECT count(*) FROM grainlift_scan('db', 'SELECT * FROM tx_test', columns := {'id': 'BIGINT', 'qty': 'BIGINT'});
----
0

# grainlift_execute and writes through the catalog commit together
statement ok
BEGIN;

statement ok
CALL grainlift_execute('db', 'INSERT INTO tx_test VALUES (2, 20)');

statement ok
INSERT INTO db.main.tx_test VALUES (3, 30);

statement ok
COMMIT;

query II
SELECT * FROM grainlift_scan('db', 'SELECT id, qty FROM tx_test ORDER BY id', columns := {'id': 'BIGINT', 'qty': 'BIGINT'});
----
2	20
3	30

# ...and roll back together
statement ok
BEGIN;

statement ok
CALL grainlift_execute('db', 'INSERT INTO tx_test VALUES (4, 40)');

statement ok
INSERT INTO db.main.tx_test VALUES (5, 50);

statement ok
ROLLBACK;

query I
SELECT count(*) FROM grainlift_scan('db', 'SELECT * FROM tx_test', columns := {'id': 'BIGINT', 'qty': 'BIGINT'});
----
2

statement ok
CALL grainlift_execute('db', 'DROP TABLE tx_test');

statement ok
DETACH db;
