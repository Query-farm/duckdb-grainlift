# name: test/sql/grainlift_secret_boundary.test
# description: which grainlift secret an ATTACH uses (boundary rule, unscoped secrets, attach_secret), without a server
# group: [grainlift]

require grainlift

require httpfs

# A secret scoped to one gateway host.
statement ok
CREATE SECRET gw (TYPE grainlift, SCOPE 'grainlift+https://host', TARGET 't');

# The scope matches only at a URL boundary.
query I
SELECT grainlift_which_secret('grainlift+https://host');
----
gw

query I
SELECT grainlift_which_secret('grainlift+https://host/');
----
gw

query I
SELECT grainlift_which_secret('grainlift+https://host/prefix/db');
----
gw

query I
SELECT grainlift_which_secret('grainlift+https://host:443');
----
gw

query I
SELECT grainlift_which_secret('grainlift+https://host?x=1');
----
gw

query I
SELECT grainlift_which_secret('grainlift+https://host#frag');
----
gw

query I
SELECT grainlift_which_secret('grainlift+https://host.evil.net') IS NULL;
----
true

query I
SELECT grainlift_which_secret('grainlift+https://hostx') IS NULL;
----
true

query I
SELECT grainlift_which_secret('grainlift+https://host.evil.net/prefix') IS NULL;
----
true

# The scheme aliases the driver accepts are compared in one form:
# grainlift:// is HTTPS, grainlift+<transport>:// is <transport>://.
query I
SELECT grainlift_which_secret('grainlift://host/db');
----
gw

query I
SELECT grainlift_which_secret('https://host/db');
----
gw

query I
SELECT grainlift_which_secret('GRAINLIFT+HTTPS://host/db');
----
gw

query I
SELECT grainlift_which_secret('grainlift+http://host') IS NULL;
----
true

query I
SELECT grainlift_which_secret('grainlift://host.evil.net') IS NULL;
----
true

# A scope ending in '/' matches anything below it.
statement ok
CREATE SECRET slash (TYPE grainlift, SCOPE 'grainlift://other/', TARGET 't');

query I
SELECT grainlift_which_secret('grainlift+https://other/db');
----
slash

query I
SELECT grainlift_which_secret('grainlift+https://other') IS NULL;
----
true

# iroh endpoint IDs: no partial-ID matches.
statement ok
CREATE SECRET iroh_ep (TYPE grainlift, URI 'grainlift+iroh://abc123', TARGET 't');

query I
SELECT grainlift_which_secret('grainlift+iroh://abc123');
----
iroh_ep

query I
SELECT grainlift_which_secret('iroh://abc123/');
----
iroh_ep

query I
SELECT grainlift_which_secret('grainlift+iroh://abc1234') IS NULL;
----
true

# The longest matching scope wins.
statement ok
CREATE SECRET gw_db (TYPE grainlift, SCOPE 'grainlift+https://host/db', TARGET 't');

query I
SELECT grainlift_which_secret('grainlift+https://host/db/x');
----
gw_db

query I
SELECT grainlift_which_secret('grainlift+https://host/dbx');
----
gw

statement ok
DROP SECRET gw_db;

# An unscoped secret is never picked by lookup...
statement ok
CREATE SECRET unscoped (TYPE grainlift, SCOPE '', TARGET 't');

query I
SELECT grainlift_which_secret('grainlift+https://anywhere.example.com') IS NULL;
----
true

# ...but can be named explicitly.
query I
SELECT grainlift_which_secret('grainlift+https://anywhere.example.com', 'unscoped');
----
unscoped

# attach_secret '' turns lookup off.
query I
SELECT grainlift_which_secret('grainlift+https://host', '') IS NULL;
----
true

# Naming a secret skips the scope check.
query I
SELECT grainlift_which_secret('grainlift+https://host', 'slash');
----
slash

statement error
SELECT grainlift_which_secret('grainlift+https://host', 'nonexistent');
----
Secret with name "nonexistent" not found

# Naming a secret of another type is an error.
statement ok
CREATE SECRET not_grainlift (TYPE http, BEARER_TOKEN 'x');

statement error
SELECT grainlift_which_secret('grainlift+https://host', 'not_grainlift');
----
is of type 'http', not 'grainlift'

statement ok
DROP SECRET not_grainlift;

# The same rules hold for ATTACH itself. These secrets carry a `driver` option,
# which ATTACH rejects before any network I/O, so the error shows whether the
# secret was used: "option 'driver' is not supported" means it was, and "a
# 'target' option ... is required" means it was not.
statement ok
CREATE SECRET marker (TYPE grainlift, SCOPE 'grainlift+https://gw.test', TARGET 't', EXTRA_OPTIONS MAP {'driver': 'x'});

statement ok
CREATE SECRET marker_unscoped (TYPE grainlift, SCOPE '', TARGET 't', EXTRA_OPTIONS MAP {'driver': 'x'});

statement error
ATTACH 'grainlift+https://gw.test/db' AS a (TYPE grainlift);
----
option 'driver' is not supported

statement error
ATTACH 'grainlift://gw.test:443' AS a (TYPE grainlift);
----
option 'driver' is not supported

statement error
ATTACH 'grainlift+https://gw.test?x' AS a (TYPE grainlift);
----
option 'driver' is not supported

statement error
ATTACH 'grainlift+https://gw.test.evil.net' AS a (TYPE grainlift);
----
a 'target' option naming the server-side target is required

statement error
ATTACH 'grainlift+https://gw.testx' AS a (TYPE grainlift);
----
a 'target' option naming the server-side target is required

# The unscoped secret is not used by lookup.
statement error
ATTACH 'grainlift+https://elsewhere.test' AS a (TYPE grainlift);
----
a 'target' option naming the server-side target is required

# ...but is by name, through `attach_secret` or `secret`.
statement error
ATTACH 'grainlift+https://elsewhere.test' AS a (TYPE grainlift, attach_secret 'marker_unscoped');
----
option 'driver' is not supported

statement error
ATTACH 'grainlift+https://elsewhere.test' AS a (TYPE grainlift, secret 'marker_unscoped');
----
option 'driver' is not supported

# attach_secret '' (or secret '') disables lookup for a matching URI.
statement error
ATTACH 'grainlift+https://gw.test/db' AS a (TYPE grainlift, attach_secret '');
----
a 'target' option naming the server-side target is required

statement error
ATTACH 'grainlift+https://gw.test/db' AS a (TYPE grainlift, secret '');
----
a 'target' option naming the server-side target is required

statement error
ATTACH 'grainlift+https://gw.test/db' AS a (TYPE grainlift, attach_secret 'nonexistent');
----
Secret with name "nonexistent" not found

statement error
ATTACH 'grainlift+https://gw.test/db' AS a (TYPE grainlift, secret 'marker', attach_secret 'marker_unscoped');
----
'secret' and 'attach_secret' name different secrets

# Naming the same secret twice is fine.
statement error
ATTACH 'grainlift+https://gw.test/db' AS a (TYPE grainlift, secret 'marker', attach_secret 'marker');
----
option 'driver' is not supported

# Credential values from secrets never show in duckdb_secrets().
statement ok
CREATE SECRET creds (TYPE grainlift, SCOPE 'grainlift+https://c', PASSWORD 'pw-s3cr3t', BEARER_TOKEN 'bt-s3cr3t',
    EXTRA_OPTIONS MAP {'adbc.postgresql.password': 'drv-s3cr3t'});

query I
SELECT secret_string NOT LIKE '%s3cr3t%' FROM duckdb_secrets() WHERE name = 'creds';
----
true

# No attachment was left behind by the failed ATTACHes.
query I
SELECT count(*) FROM duckdb_databases() WHERE type = 'grainlift';
----
0
