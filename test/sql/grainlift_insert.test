# name: test/sql/grainlift_insert.test
# description: test grainlift_insert function for bulk data ingestion
# group: [adbc]

require grainlift

require httpfs

require-env GRAINLIFT_URI

require-env GRAINLIFT_TOKEN

# ============================================
# NULL Connection Handle Tests
# ============================================

# Test grainlift_insert with NULL connection handle
statement error
SELECT * FROM grainlift_insert(NULL, 'test', (SELECT 1));
----
Invalid Input Error: grainlift_insert: Connection handle cannot be NULL

# Test grainlift_insert with NULL table name
statement error
SELECT * FROM grainlift_insert(12345, NULL, (SELECT 1));
----
Invalid Input Error: grainlift_insert: Target table name cannot be NULL

# ============================================
# Normal Tests
# ============================================

statement ok
SET VARIABLE conn_id = (SELECT grainlift_connect({'uri': '${GRAINLIFT_URI}', 'target': 'sqlite', 'bearer_token': '${GRAINLIFT_TOKEN}', 'remote_uri': ':memory:'}));

# Create source data (20,000 rows to test multiple batches)
statement ok
CREATE TABLE insert_source AS SELECT i AS id, 'name_' || i AS name FROM range(20000) t(i);

# Test grainlift_insert with create mode
query I
SELECT * FROM grainlift_insert(getvariable('conn_id')::BIGINT, 'bulk_test', (SELECT * FROM insert_source), mode := 'create');
----
20000

# Verify the data was inserted
query I
SELECT COUNT(*) FROM grainlift_scan(getvariable('conn_id')::BIGINT, 'SELECT * FROM bulk_test', columns := {'id': 'BIGINT', 'name': 'VARCHAR'});
----
20000

# Test grainlift_insert with append mode
query I
SELECT * FROM grainlift_insert(getvariable('conn_id')::BIGINT, 'bulk_test', (SELECT * FROM insert_source WHERE id < 1000), mode := 'append');
----
1000

# Verify append worked
query I
SELECT COUNT(*) FROM grainlift_scan(getvariable('conn_id')::BIGINT, 'SELECT * FROM bulk_test', columns := {'id': 'BIGINT', 'name': 'VARCHAR'});
----
21000

# Test grainlift_insert with invalid connection
statement error
SELECT * FROM grainlift_insert(12345, 'test', (SELECT 1));
----
Invalid Input Error: grainlift_insert: Invalid connection handle: 12345

# Test grainlift_insert with invalid mode
statement error
SELECT * FROM grainlift_insert(getvariable('conn_id')::BIGINT, 'test', (SELECT 1), mode := 'invalid');
----
Invalid Input Error: grainlift_insert: Invalid mode 'invalid'. Must be one of: create, append, replace, create_append

# ============================================
# Statement options
# ============================================

# STRUCT form: options reach the driver (SQLite honors adbc.ingest.temporary)
query I
SELECT * FROM grainlift_insert(getvariable('conn_id')::BIGINT, 'tmp_ingest', (SELECT * FROM insert_source WHERE id < 10), mode := 'create', options := {'adbc.ingest.temporary': 'true'});
----
10

query I
SELECT COUNT(*) FROM grainlift_scan(getvariable('conn_id')::BIGINT, 'SELECT * FROM temp.tmp_ingest', columns := {'id': 'BIGINT', 'name': 'VARCHAR'});
----
10

query I
SELECT COUNT(*) FROM grainlift_scan(getvariable('conn_id')::BIGINT, 'SELECT name FROM main.sqlite_master WHERE name = ''tmp_ingest''', columns := {'name': 'VARCHAR'});
----
0

# MAP form
query I
SELECT * FROM grainlift_insert(getvariable('conn_id')::BIGINT, 'tmp_ingest_map', (SELECT * FROM insert_source WHERE id < 5), mode := 'create', options := MAP {'adbc.ingest.temporary': 'true'});
----
5

query I
SELECT COUNT(*) FROM grainlift_scan(getvariable('conn_id')::BIGINT, 'SELECT * FROM temp.tmp_ingest_map', columns := {'id': 'BIGINT', 'name': 'VARCHAR'});
----
5

# Options owned by grainlift_insert itself are rejected
statement error
SELECT * FROM grainlift_insert(getvariable('conn_id')::BIGINT, 'x', (SELECT 1), options := {'adbc.ingest.mode': 'adbc.ingest.mode.replace'});
----
Invalid Input Error: grainlift_insert: option 'adbc.ingest.mode' is set by grainlift_insert itself

# options must be a STRUCT or MAP
statement error
SELECT * FROM grainlift_insert(getvariable('conn_id')::BIGINT, 'x', (SELECT 1), options := 'adbc.ingest.temporary=true');
----
Invalid Input Error: grainlift_insert: options must be a STRUCT or MAP

# Options the driver does not recognize surface the driver's error
statement error
SELECT * FROM grainlift_insert(getvariable('conn_id')::BIGINT, 'x', (SELECT 1), mode := 'create', options := {'not.a.real.option': 'x'});
----
Failed to set statement option 'not.a.real.option'

# Clean up
statement ok
CALL grainlift_disconnect(getvariable('conn_id')::BIGINT);

statement ok
DROP TABLE insert_source;
