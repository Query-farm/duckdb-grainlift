{
  "name": "grainlift-browser-test",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:app && npm run build:shell",
    "build:app": "esbuild app.js --bundle --format=esm --outfile=site/app.bundle.js && cp node_modules/@haybarn/haybarn-wasm/dist/duckdb-threads.wasm node_modules/@haybarn/haybarn-wasm/dist/duckdb-browser-threads.worker.js node_modules/@haybarn/haybarn-wasm/dist/duckdb-browser-threads.pthread.worker.js node_modules/@haybarn/haybarn-wasm/dist/duckdb-base.wasm node_modules/@haybarn/haybarn-wasm/dist/duckdb-browser-base.worker.js site/",
    "build:shell": "esbuild shell-demo.js --bundle --format=esm --outfile=site/shell-demo.bundle.js && cp shell-build/crate/pkg/shell_bg.wasm node_modules/xterm/css/xterm.css site/"
  },
  "dependencies": {
    "@haybarn/haybarn-wasm": "2.0.0-rc11",
    "apache-arrow": "^17.0.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0",
    "xterm-addon-webgl": "^0.16.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
